# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-04

# Secret shared with the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=your_secret_token

# Public URL of the deployed site (used for sitemap, RSS, OG and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Never commit real values; put them in .env.local or your Vercel project settings.
